// Hack memory map: RAM16K, Screen, Keyboard.
CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:
    DMux4Way(in=load, sel=address[13..14], a=loadLow, b=loadHigh, c=loadScreen, d=loadKeyboard);
    // RAM occupies 0..16383 (both 00 and 01 selector cases).
    Or(a=loadLow, b=loadHigh, out=loadRAM);
    RAM16K(in=in, load=loadRAM, address=address[0..13], out=ramOut);
    Screen(in=in, load=loadScreen, address=address[0..12], out=screenOut);
    Keyboard(out=keyboardOut);
    // Select RAM for addresses below SCREEN, screen for SCREEN..KBD-1, keyboard for KBD.
    Mux4Way16(a=ramOut, b=ramOut, c=screenOut, d=keyboardOut,
              sel=address[13..14], out=out);
}
